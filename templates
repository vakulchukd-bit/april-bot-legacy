<!DOCTYPE html>
<html lang="ru">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>APRIL AI Checkout</title>

    <!-- 🔥 PAYPAL SMART SDK -->
    <script
        src="https://www.paypal.com/sdk/js?client-id={{ client_id }}&currency=USD&intent=capture&components=buttons,funding-eligibility&enable-funding=venmo,paylater,card"
        onload="console.log('✅ PAYPAL SDK LOADED')"
        onerror="console.error('❌ PAYPAL SDK FAILED')"
    ></script>

    <style>

        body {

            margin: 0;
            padding: 0;

            background: #0f0f0f;
            color: white;

            font-family: Arial, sans-serif;

            display: flex;
            justify-content: center;
            align-items: center;

            min-height: 100vh;
        }

        .card {

            width: 92%;
            max-width: 420px;

            background: #181818;

            border-radius: 24px;

            padding: 28px;

            box-sizing: border-box;

            box-shadow:
                0 0 40px rgba(0,0,0,0.5);
        }

        .logo {

            font-size: 34px;
            font-weight: bold;

            margin-bottom: 10px;

            text-align: center;
        }

        .subtitle {

            color: #aaaaaa;

            margin-bottom: 28px;

            text-align: center;
        }

        .plan {

            background: #202020;

            border-radius: 18px;

            padding: 18px;

            margin-bottom: 24px;
        }

        .plan-name {

            font-size: 24px;
            font-weight: bold;
        }

        .price {

            margin-top: 10px;

            font-size: 32px;
            font-weight: bold;
        }

        .features {

            margin-top: 16px;

            color: #cccccc;

            line-height: 1.7;
        }

        #paypal-button-container {

            margin-top: 26px;
        }

        .loading {

            text-align: center;

            margin-top: 18px;

            color: #888;
        }

        .success {

            display: none;

            text-align: center;

            margin-top: 20px;

            color: #4dff88;

            font-size: 20px;

            font-weight: bold;
        }

        .debug {

            margin-top: 20px;

            font-size: 12px;

            color: #777;

            word-break: break-word;
        }

    </style>

</head>

<body>

<div class="card">

    <div class="logo">
        APRIL AI
    </div>

    <div class="subtitle">
        Быстрая безопасная оплата
    </div>

    <div class="plan">

        <div class="plan-name">
            {{ plan_name }}
        </div>

        <div class="price">
            ${{ amount }}
        </div>

        <div class="features">
            ✓ Google Pay<br>
            ✓ Apple Pay<br>
            ✓ Банковские карты<br>
            ✓ PayPal<br>
            ✓ Моментальная активация
        </div>

    </div>

    <div id="paypal-button-container"></div>

    <div class="loading" id="loadingBox">
        🔒 Secure Smart Checkout
    </div>

    <div
        class="success"
        id="successBox"
    >
        ✅ Оплата прошла успешно
    </div>

    <div
        class="debug"
        id="debugBox"
    >
        DEBUG START...
    </div>

</div>

<script>

console.log("🔥 CHECKOUT START");

const debugBox =
    document.getElementById("debugBox");

function debug(msg) {

    console.log(msg);

    debugBox.innerHTML +=
        "<br>" + msg;
}

debug("PAGE LOADED");

const AMOUNT = "{{ amount }}";
const PLAN = "{{ plan }}";
const USER_ID = "{{ user_id }}";

debug("AMOUNT: " + AMOUNT);
debug("PLAN: " + PLAN);
debug("USER_ID: " + USER_ID);

if (!window.paypal) {

    debug("❌ window.paypal NOT FOUND");

} else {

    debug("✅ window.paypal OK");
}

paypal.Buttons({

    style: {

        layout: 'vertical',
        shape: 'pill',
        label: 'pay',
        height: 50,
        tagline: false

    },

    // =====================================================
    // 🔥 CREATE ORDER
    // =====================================================

    async createOrder() {

        debug("CREATE ORDER START");

        try {

            const response = await fetch(
                "/create-order",
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        amount: AMOUNT,
                        plan: PLAN,
                        user_id: USER_ID

                    })
                }
            );

            debug("CREATE ORDER RESPONSE");

            const data = await response.json();

            debug(
                "ORDER ID: " + data.id
            );

            return data.id;

        } catch(err) {

            debug(
                "❌ CREATE ORDER ERROR: " + err
            );

            console.error(err);
        }
    },

    // =====================================================
    // 🔥 CAPTURE
    // =====================================================

    async onApprove(data) {

        debug(
            "ON APPROVE: " + data.orderID
        );

        try {

            const response = await fetch(
                "/capture-order",
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        orderID: data.orderID

                    })
                }
            );

            const result = await response.json();

            debug(
                "CAPTURE SUCCESS"
            );

            console.log(result);

            document
                .getElementById("successBox")
                .style.display = "block";

            setTimeout(() => {

                window.location.href =
                    "/paypal-success";

            }, 1200);

        } catch(err) {

            debug(
                "❌ CAPTURE ERROR: " + err
            );

            console.error(err);
        }
    },

    // =====================================================
    // ❌ CANCEL
    // =====================================================

    onCancel() {

        debug("PAYMENT CANCELLED");

        window.location.href =
            "/paypal-cancel";
    },

    // =====================================================
    // 🔥 ERROR
    // =====================================================

    onError(err) {

        debug(
            "❌ PAYPAL ERROR: " + err
        );

        console.error(err);

        alert(
            "Ошибка оплаты"
        );
    }

}).render('#paypal-button-container')
.then(() => {

    debug(
        "✅ BUTTONS RENDERED"
    );

})
.catch(err => {

    debug(
        "❌ RENDER ERROR: " + err
    );

    console.error(err);
});

</script>

</body>
</html>
